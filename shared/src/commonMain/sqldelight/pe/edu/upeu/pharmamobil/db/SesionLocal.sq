CREATE TABLE sesion_guardada (
    id INTEGER NOT NULL PRIMARY KEY,
    usuario TEXT NOT NULL,
    nombre_completo TEXT NOT NULL,
    permisos TEXT NOT NULL
);

guardarSesion:
INSERT OR REPLACE INTO sesion_guardada(id, usuario, nombre_completo, permisos)
VALUES (1, ?, ?, ?);

leerSesion:
SELECT usuario, nombre_completo, permisos
FROM sesion_guardada
WHERE id = 1;

borrarSesion:
DELETE FROM sesion_guardada WHERE id = 1;
